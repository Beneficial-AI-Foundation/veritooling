    leg_proved_claimed [fillcolor="#BFE3D3", color="#1F8A65", style="filled,diagonals", fontcolor="#1A1A1A", label="proved (claimed, unconfirmed)", shape="box", fontsize="9"];
    leg_machine_verified -> leg_proved_claimed [style=invis];
    leg_ready [fillcolor="#FFFFFF", color="#1F8A65", style="filled", fontcolor="#333333", label="ready to formalize", shape="box", fontsize="9"];
    leg_proved_claimed -> leg_ready [style=invis];
    leg_not_ready [fillcolor="#FFFFFF", color="#888899", style="filled,dashed", fontcolor="#333333", label="not ready to formalize", shape="box", fontsize="9"];
    leg_ready -> leg_not_ready [style=invis];
  }
}
